    <string name="str_pinout_zif40_header">Socket Universal ZIF 40 Pines</string>
    <string name="str_pinout_zif40_note">⚠️ SIEMPRE alinear chips DIP al FONDO INFERIOR del ZIF con muesca hacia arriba</string>
    <string name="str_pinout_spi25_header">SPI Flash Serie 25xxx — Conexión a MiniPro</string>
    <string name="str_pinout_spi25_note">⚠️ Pines WP# y HOLD# deben estar en nivel alto, 3.3V, si no se usan</string>
    <string name="str_pinout_i2c24_header">I2C EEPROM 24Cxx — Pinout y Conexión MiniPro</string>
    <string name="str_pinout_i2c24_note">⚠️ Pin 7 WP a GND para permitir escritura. A0, A1 y A2 definen la dirección I2C</string>
    <string name="str_pinout_mw93_header">Microwire 93Cxx — Pinout y Organización de 8 o 16 bits</string>
    <string name="str_pinout_mw93_note">⚠️ Pin 6 ORG a VCC para modo 16 bits Word, a GND para modo 8 bits Byte</string>
    <string name="str_pinout_parallel_header">Memorias Paralelas EPROM / Flash DIP32 — Series 27C, 28C, 29F, 39SF</string>
    <string name="str_pinout_parallel_note">⚠️ Cuidado con el voltaje VPP en EPROMs 27C: 12.5V o 21V según especificación</string>
    <string name="str_pinout_icsp_header">Header ICSP 6 Pines para Programación en Circuito</string>
    <string name="str_pinout_icsp_note">⚠️ Mantener cables ICSP cortos, menos de 15 cm. Verificar voltajes VDD y VPP</string>
    <string name="str_pinout_pic_icsp_header">Guía Pinouts ICSP para Microchip PIC (DIP8..DIP40)</string>
    <string name="str_pinout_pic_icsp_note">⚠️ Pin 1 VPP / MCLR recibe alto voltaje de programación (9V-13V)</string>
    <string name="str_pinout_avrisp_header">Conectores AVR ISP Estándar de 6 y 10 Pines</string>
    <string name="str_pinout_avrisp_note">⚠️ Para ATmega328P, Arduino y ATtiny: conectar MISO, MOSI, SCK, RESET, VCC, GND</string>
    <string name="str_pinout_plcc32_header">Adaptador PLCC32 a DIP32 para Memorias BIOS y Flash</string>
    <string name="str_pinout_plcc32_note">⚠️ Respetar el chaflán y punto de Pin 1 en el zócalo PLCC32 del adaptador</string>

