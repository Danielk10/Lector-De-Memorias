    <string name="str_pinout_zif40_header">Universal 40-Pin ZIF Socket (TL866 / T48 / T56)</string>
    <string name="str_pinout_zif40_note">⚠️ ALWAYS align DIP chips to the BOTTOM of the ZIF socket with NOTCH UP</string>
    <string name="str_pinout_spi25_header">SPI Flash 25xxx (SOIC8 / DIP8) — MiniPro Connection</string>
    <string name="str_pinout_spi25_note">⚠️ WP# and HOLD# must be HIGH (VCC 3.3V) when unused</string>
    <string name="str_pinout_i2c24_header">I2C EEPROM 24Cxx — Pinout and MiniPro Connection</string>
    <string name="str_pinout_i2c24_note">⚠️ Pin 7 WP to GND to enable writing. A0/A1/A2 define I2C address</string>
    <string name="str_pinout_mw93_header">Microwire 93Cxx — Pinout and Organization (8/16 bits)</string>
    <string name="str_pinout_mw93_note">⚠️ Pin 6 ORG to VCC = 16-bit word mode, to GND = 8-bit byte mode</string>
    <string name="str_pinout_parallel_header">Parallel EPROM / Flash DIP32 (27C, 28C, 29F, 39SF)</string>
    <string name="str_pinout_parallel_note">⚠️ Be cautious with VPP voltage on 27C EPROMs (12.5V or 21V per datasheet)</string>
    <string name="str_pinout_icsp_header">6-Pin ICSP Header (In-Circuit Programming TL866 / T48)</string>
    <string name="str_pinout_icsp_note">⚠️ Keep ICSP wires short (&lt;15 cm). Verify VDD/VPP voltages</string>
    <string name="str_pinout_avrisp_header">Standard AVR ISP Headers (6-Pin and 10-Pin)</string>
    <string name="str_pinout_avrisp_note">⚠️ For ATmega328P / Arduino / ATtiny — connect MISO, MOSI, SCK, RESET, VCC, GND</string>
    <string name="str_pinout_plcc32_header">PLCC32 to DIP32 Adapter (BIOS / Flash Chips)</string>
    <string name="str_pinout_plcc32_note">⚠️ Match Pin 1 chamfer/notch on the PLCC32 adapter socket</string>

