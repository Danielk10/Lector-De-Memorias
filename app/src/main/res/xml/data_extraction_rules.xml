<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for Android 12+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Never restore purchases or passes on another device. -->
        <exclude domain="sharedpref" path="billing_prefs.xml" />
        <exclude domain="sharedpref" path="pro_pass_prefs.xml" />
        <exclude domain="file" path=".eeprom_flasher_pro_pass.dat" />
    </cloud-backup>
    <device-transfer>
        <!-- The pass is bound to the original device, so it is not transferable. -->
        <exclude domain="sharedpref" path="billing_prefs.xml" />
        <exclude domain="sharedpref" path="pro_pass_prefs.xml" />
        <exclude domain="file" path=".eeprom_flasher_pro_pass.dat" />
    </device-transfer>
</data-extraction-rules>
