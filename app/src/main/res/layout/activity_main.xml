<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="8dp">

    <!-- Indicador de Carga Inicial -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/secondary" />

        <TextView
            android:id="@+id/tvLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/str_preparando_depe"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- UI Principal -->
    <LinearLayout
        android:id="@+id/layoutMainUI"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Banner Estado USB y Operación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/str_estado_usb_desc"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvOperationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFB74D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Fila Selector Programador -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_seleccionar_dispositivo"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginEnd="6dp" />

            <Spinner
                android:id="@+id/spinnerDevices"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner"
                android:popupBackground="@color/surface_dark" />
        </LinearLayout>

        <!-- Botón Conectar Programador -->
        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            app:backgroundTint="@color/btn_tint_blue"
            android:textColor="@color/btn_text_color"
            android:text="@string/str_detectar_y_cone"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <!-- Fila Modelo de Chip + Botones Auto-detectar & Catálogo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_seleccionar_chip"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/etChipModel"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:hint="@string/str_hint_chip"
                android:text="W25Q128FV"
                android:textColor="#FFFFFF"
                android:textColorHint="#757575"
                android:background="@drawable/bg_input_field"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="13sp"
                android:inputType="textCapCharacters"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnAutodetectChip"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginStart="4dp"
                android:text="@string/str_autodetectar_chip"
                android:textSize="12sp"
                android:enabled="false"
                app:backgroundTint="@color/btn_tint_orange"
                android:textColor="@color/btn_text_color" />

            <Button
                android:id="@+id/btnSearchChip"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginStart="4dp"
                android:text="@string/str_buscar_chip"
                android:textSize="12sp"
                app:backgroundTint="@color/btn_tint_grey"
                android:textColor="@color/btn_text_color" />
        </LinearLayout>

        <!-- Botón Verificar -->
        <Button
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:enabled="false"
            app:backgroundTint="@color/btn_tint_green"
            android:textColor="@color/btn_text_color"
            android:text="@string/str_verificar"
            android:textSize="13sp"
            android:layout_marginBottom="3dp" />

        <!-- Fila: Leer + Escribir -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">

            <Button
                android:id="@+id/btnRead"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:enabled="false"
                app:backgroundTint="@color/btn_tint_blue"
                android:textColor="@color/btn_text_color"
                android:text="@string/str_leer_backup"
                android:textSize="13sp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnWrite"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:enabled="false"
                app:backgroundTint="@color/btn_tint_red"
                android:textColor="@color/btn_text_color"
                android:text="@string/str_escribir"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Fila: Cargar ROM + Guardar ROM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">

            <Button
                android:id="@+id/btnImport"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                app:backgroundTint="@color/btn_tint_grey"
                android:textColor="@color/btn_text_color"
                android:text="@string/str_cargar_rom"
                android:textSize="13sp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnExport"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                app:backgroundTint="@color/btn_tint_grey"
                android:textColor="@color/btn_text_color"
                android:text="@string/str_guardar_rom"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Fila: Borrar Chip + Limpiar Datos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">

            <Button
                android:id="@+id/btnEraseChip"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:enabled="false"
                app:backgroundTint="@color/btn_tint_red"
                android:textColor="@color/btn_text_color"
                android:text="@string/str_borrar_chip"
                android:textSize="13sp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnQuickClear"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                app:backgroundTint="@color/btn_tint_grey"
                android:textColor="@color/btn_text_color"
                android:text="@string/str_borrar_rom"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Caja de Comando Personalizado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <EditText
                android:id="@+id/etCustomCommand"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:hint="@string/str_hint_comando"
                android:inputType="text"
                android:maxLines="1"
                android:ellipsize="end"
                android:background="@drawable/bg_input_field"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColorHint="#757575"
                android:textColor="#4DB6AC"
                android:fontFamily="monospace"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRunCustomCommand"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="4dp"
                android:text="@string/str_ejecutar_instru"
                android:textSize="12sp"
                app:backgroundTint="@color/btn_tint_blue"
                android:textColor="@color/btn_text_color" />
        </LinearLayout>

        <!-- Cabecera Terminal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/str_terminal_salida"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnAbort"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/str_detener"
                android:textColor="@color/btn_text_color"
                app:backgroundTint="@color/btn_tint_darkred"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textSize="11sp"
                android:visibility="gone"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnClearLogs"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/str_limpiar"
                app:backgroundTint="@color/btn_tint_grey"
                android:textColor="@color/btn_text_color"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Terminal de Logs usando LogScrollView -->
        <com.diamon.mini.ui.views.LogScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0"
            android:background="@color/bg_terminal"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:lineSpacingExtra="2dp"
                android:longClickable="true"
                android:textColor="@color/text_terminal"
                android:textSize="12sp"
                android:text="@string/str_log_" />

        </com.diamon.mini.ui.views.LogScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>