<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="12dp">

    <!-- Indicador de Carga Inicial -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/secondary" />

        <TextView
            android:id="@+id/tvLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/str_preparando_depe"
            android:textColor="#E0E0E0"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- UI Principal -->
    <LinearLayout
        android:id="@+id/layoutMainUI"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Estado USB -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/str_estado_usb_desc"
            android:textColor="#4CAF50"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Spinner dispositivos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_seleccionar_dispositivo"
                android:textColor="#B0BEC5"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <Spinner
                android:id="@+id/spinnerDevices"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner"
                android:popupBackground="#1B1E2B" />
        </LinearLayout>

        <!-- Campo Modelo de Chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_seleccionar_chip"
                android:textColor="#B0BEC5"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etChipModel"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="@string/str_hint_chip"
                android:text="AT24C02C"
                android:textColor="#FFFFFF"
                android:textColorHint="#757575"
                android:background="@drawable/bg_spinner"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textSize="14sp"
                android:inputType="text"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Botón Conectar -->
        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            app:backgroundTint="@color/btn_tint_blue"
            android:textColor="@color/btn_text_color"
            android:text="@string/str_detectar_y_cone"
            android:layout_marginBottom="3dp" />

        <!-- Fila: Identificar + Verificar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">

            <Button
                android:id="@+id/btnProbe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:backgroundTint="@color/btn_tint_blue"
                android:textColor="@color/btn_text_color"
                android:text="@string/str_identificar_chi" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnVerify"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:backgroundTint="@color/btn_tint_green"
                android:textColor="@color/btn_text_color"
                android:text="@string/str_verificar" />
        </LinearLayout>

        <!-- Fila: Leer + Escribir -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">

            <Button
                android:id="@+id/btnRead"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:backgroundTint="@color/btn_tint_blue"
                android:textColor="@color/btn_text_color"
                android:text="@string/str_leer_backup" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnWrite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:backgroundTint="@color/btn_tint_red"
                android:textColor="@color/btn_text_color"
                android:text="@string/str_escribir" />
        </LinearLayout>

        <!-- Fila: Cargar + Guardar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">

            <Button
                android:id="@+id/btnImport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:backgroundTint="@color/btn_tint_grey"
                android:textColor="@color/btn_text_color"
                android:text="@string/str_cargar_rom" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnExport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:backgroundTint="@color/btn_tint_grey"
                android:textColor="@color/btn_text_color"
                android:text="@string/str_guardar_rom" />
        </LinearLayout>

        <!-- Fila: Borrar Chip + Limpiar Datos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="3dp">

            <Button
                android:id="@+id/btnEraseChip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:minHeight="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:backgroundTint="@color/btn_tint_red"
                android:textColor="@color/btn_text_color"
                android:text="@string/str_borrar_chip" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnQuickClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:backgroundTint="@color/btn_tint_grey"
                android:textColor="@color/btn_text_color"
                android:text="@string/str_borrar_rom" />
        </LinearLayout>

        <!-- Caja de Comando Custom -->
        <EditText
            android:id="@+id/etCustomCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/str_hint_comando"
            android:inputType="text"
            android:maxLines="1"
            android:ellipsize="end"
            android:background="#1B1E2B"
            android:padding="8dp"
            android:textColorHint="#757575"
            android:textColor="#4DB6AC"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:layout_marginBottom="3dp" />

        <!-- Botón Ejecutar -->
        <Button
            android:id="@+id/btnRunCustomCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/str_ejecutar_instru"
            app:backgroundTint="@color/btn_tint_blue"
            android:textColor="@color/btn_text_color"
            android:layout_marginBottom="3dp" />

        <!-- Cabecera Terminal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/tvOperationStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/str_terminal_salida"
                android:textColor="#B0BEC5"
                android:textStyle="bold"
                android:textSize="13sp"
                android:layout_gravity="center_vertical"
                android:singleLine="true"
                android:ellipsize="end" />

            <Button
                android:id="@+id/btnAbort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_detener"
                android:textColor="@color/btn_text_color"
                app:backgroundTint="@color/btn_tint_darkred"
                android:minHeight="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnClearLogs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_limpiar"
                android:minHeight="0dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>
        </LinearLayout>

        <!-- Terminal de Logs -->
        <ScrollView
            android:id="@+id/scrollLog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0"
            android:background="@color/bg_terminal"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:lineSpacingExtra="3dp"
                android:longClickable="true"
                android:textColor="@color/text_terminal"
                android:textSize="12sp"
                android:text="@string/str_log_" />

        </ScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>